{
  "name": "LedgerGuard",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "version": "latest",
      "dockerDashComposeVersion": "v2"
    },
    "ghcr.io/devcontainers/features/node:1": {
      "version": "24"
    }
  },
  "forwardPorts": [8080, 3000, 3333, 8025, 9001, 3001, 9090],
  "portsAttributes": {
    "8080": { "label": "LedgerGuard", "onAutoForward": "openBrowser" },
    "3333": { "label": "API / Swagger" },
    "8025": { "label": "Mailpit" },
    "9001": { "label": "MinIO" },
    "3001": { "label": "Grafana" },
    "9090": { "label": "Prometheus" }
  },
  "postCreateCommand": "cp -n .env.example .env || true",
  "remoteUser": "vscode"
}
