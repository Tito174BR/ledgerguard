NODE_ENV=development
API_PORT=3333
WORKER_HEALTH_PORT=3334

POSTGRES_DB=ledgerguard
POSTGRES_USER=ledgerguard
POSTGRES_PASSWORD=ledgerguard
DATABASE_URL=postgresql://ledgerguard_app:ledgerguard-app@postgres:5432/ledgerguard
DATABASE_MIGRATOR_URL=postgresql://ledgerguard:ledgerguard@postgres:5432/ledgerguard
WORKER_DATABASE_URL=postgresql://ledgerguard_worker:ledgerguard-worker@postgres:5432/ledgerguard

REDIS_URL=redis://redis:6379

JWT_SECRET=change-this-jwt-secret-with-at-least-32-characters
REFRESH_SECRET=change-this-refresh-secret-with-at-least-32-characters
FIELD_ENCRYPTION_KEY=change-this-32-byte-secret-key-now
CORS_ORIGIN=http://localhost:3000,http://localhost:8080

MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=ledgerguard
MINIO_SECRET_KEY=ledgerguard-secret
MINIO_BUCKET=ledgerguard-files

SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM="LedgerGuard <no-reply@ledgerguard.local>"

SEED_INITIAL_DATA=true
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
